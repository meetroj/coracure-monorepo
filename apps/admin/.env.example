# Copy to .env.local (git-ignored) to run the panel against a real backend.
# Leave VITE_API_URL unset to keep the panel on its built-in fixtures.
#
# Nothing secret goes here: anything in a Vite bundle is readable in devtools.
#
# Point this at a LOCAL backend while integrating (see CLAUDE.md: docker compose up,
# db:migrate, db:seed, start:dev). Do not point a dev build at production.
VITE_API_URL=http://localhost:3000/api/v1
